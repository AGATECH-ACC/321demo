# Generate your real secret with npm run setup. Never reuse this placeholder.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
DATABASE_PATH=./data/studio.sqlite

# Vercel: use a persistent Turso database instead of DATABASE_PATH.
# Set these in Vercel Project Settings > Environment Variables.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-private-database-token
# BETTER_AUTH_URL=https://your-project.vercel.app
